<ProgressBar android:id="@+id/rulesProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
<TextView android:id="@+id/rulesMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:saveEnabled="false" />
