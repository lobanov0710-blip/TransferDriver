<EditText android:id="@+id/rulesReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true" android:inputType="textNoSuggestions" android:imeOptions="flagNoPersonalizedLearning" android:hint="@string/rules_reason" android:maxLength="1000" android:saveEnabled="false" android:importantForAutofill="no" />
