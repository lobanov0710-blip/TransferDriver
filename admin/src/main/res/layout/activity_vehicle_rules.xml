<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assessment_model" />
<EditText android:id="@+id/rulesModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true" android:inputType="textNoSuggestions" android:imeOptions="flagNoPersonalizedLearning" android:hint="@string/assessment_model" android:maxLength="80" android:saveEnabled="false" android:importantForAutofill="no" />
