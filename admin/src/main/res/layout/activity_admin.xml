<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/adminRoot" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/heading" android:textAppearance="?attr/textAppearanceHeadline5" />
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:saveEnabled="false" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <LinearLayout android:id="@+id/loginForm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sign_in_title" />
            <EditText android:id="@+id/login" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/login_hint" android:inputType="textNoSuggestions" android:singleLine="true"
                android:saveEnabled="false" android:importantForAutofill="no" android:maxLength="128" android:minHeight="48dp" />
            <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/password_hint" android:inputType="textPassword" android:singleLine="true"
                android:saveEnabled="false" android:importantForAutofill="no" android:maxLength="1024" android:minHeight="48dp" />
            <Button android:id="@+id/signIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sign_in" />
            <Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" />
        </LinearLayout>
        <LinearLayout android:id="@+id/profile" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/role" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:saveEnabled="false" android:textAppearance="?attr/textAppearanceHeadline6" />
            <TextView android:id="@+id/security" android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false" />
            <Button android:id="@+id/queue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/registrations" />
            <TextView android:id="@+id/registrations" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:saveEnabled="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/mfaForm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mfa_prompt" />
            <EditText android:id="@+id/totpCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/totp_hint" android:inputType="numberPassword" android:maxLength="6" android:minHeight="48dp"
                android:saveEnabled="false" android:importantForAutofill="no" />
            <Button android:id="@+id/verifyTotp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verify_totp" />
            <EditText android:id="@+id/recoveryCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/recovery_hint" android:inputType="textPassword" android:maxLength="39" android:minHeight="48dp"
                android:saveEnabled="false" android:importantForAutofill="no" />
            <Button android:id="@+id/verifyRecovery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verify_recovery" />
        </LinearLayout>
        <LinearLayout android:id="@+id/bootstrapForm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bootstrap_prompt" />
            <EditText android:id="@+id/bootstrapCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/bootstrap_hint" android:inputType="textPassword" android:maxLength="100" android:minHeight="48dp"
                android:saveEnabled="false" android:importantForAutofill="no" />
            <Button android:id="@+id/startEnrollment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_enrollment" />
        </LinearLayout>
        <LinearLayout android:id="@+id/enrollmentForm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enrollment_prompt" />
            <TextView android:id="@+id/enrollmentSecret" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:saveEnabled="false" android:textIsSelectable="false" android:importantForAutofill="no" />
            <EditText android:id="@+id/enrollmentCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/totp_hint" android:inputType="numberPassword" android:maxLength="6" android:minHeight="48dp"
                android:saveEnabled="false" android:importantForAutofill="no" />
            <Button android:id="@+id/confirmEnrollment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/confirm_enrollment" />
        </LinearLayout>
        <LinearLayout android:id="@+id/recoveryForm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recovery_prompt" />
            <TextView android:id="@+id/backupCodes" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:saveEnabled="false" android:textIsSelectable="false" android:importantForAutofill="no" />
            <Button android:id="@+id/recoverySaved" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recovery_saved" />
        </LinearLayout>
        <Button android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/logout" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
