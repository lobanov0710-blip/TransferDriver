<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/assessmentRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants">
    <com.google.android.material.appbar.MaterialToolbar xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/assessmentToolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_assignment_back" app:navigationContentDescription="@string/classification_close" app:title="@string/assessment_title" />
    <ProgressBar android:id="@+id/assessmentProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/assessmentMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false" android:accessibilityLiveRegion="polite" />
    <ScrollView android:id="@+id/assessmentScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:saveEnabled="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false">
            <TextView android:id="@+id/assessmentSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:textAppearance="?attr/textAppearanceBodyLarge" android:saveEnabled="false" />
            <LinearLayout android:id="@+id/assessmentForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false">
                <EditText android:id="@+id/assessmentMake" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textNoSuggestions" android:imeOptions="flagNoPersonalizedLearning" android:singleLine="true" android:maxLength="80" android:hint="@string/assessment_make" android:saveEnabled="false" android:importantForAutofill="no" />
                <EditText android:id="@+id/assessmentModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textNoSuggestions" android:imeOptions="flagNoPersonalizedLearning" android:singleLine="true" android:maxLength="80" android:hint="@string/assessment_model" android:saveEnabled="false" android:importantForAutofill="no" />
                <EditText android:id="@+id/assessmentYear" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:imeOptions="flagNoPersonalizedLearning" android:singleLine="true" android:maxLength="4" android:hint="@string/assessment_year" android:saveEnabled="false" android:importantForAutofill="no" />
                <Spinner android:id="@+id/assessmentPower" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false" android:contentDescription="@string/assessment_power" />
                <Spinner android:id="@+id/assessmentBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false" android:contentDescription="@string/assessment_body" />
                <CheckBox android:id="@+id/assessmentException" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false" android:text="@string/assessment_exception" />
                <EditText android:id="@+id/assessmentBasis" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textNoSuggestions" android:imeOptions="flagNoPersonalizedLearning" android:singleLine="true" android:maxLength="80" android:hint="@string/assessment_basis" android:saveEnabled="false" android:importantForAutofill="no" />
                <com.google.android.material.button.MaterialButton android:id="@+id/assessmentRuleLoad" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assessment_load_rule" />
                <TextView android:id="@+id/assessmentRule" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:saveEnabled="false" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assessment_documents" />
                <Spinner android:id="@+id/assessmentFront" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false" android:contentDescription="@string/assessment_front" />
                <com.google.android.material.button.MaterialButton android:id="@+id/assessmentPreviewFront" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assessment_preview_front" />
                <Spinner android:id="@+id/assessmentBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false" android:contentDescription="@string/assessment_back" />
                <com.google.android.material.button.MaterialButton android:id="@+id/assessmentPreviewBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assessment_preview_back" />
                <ImageView android:id="@+id/assessmentPreview" android:layout_width="match_parent" android:layout_height="280dp" android:visibility="gone" android:adjustViewBounds="true" android:scaleType="fitCenter" android:saveEnabled="false" android:contentDescription="@string/review_private_image" />
                <LinearLayout android:id="@+id/assessmentConditions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false" />
                <CheckBox android:id="@+id/assessmentWaiveYear" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assessment_waive_year" android:saveEnabled="false" />
                <EditText android:id="@+id/assessmentReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textNoSuggestions|textCapSentences" android:imeOptions="flagNoPersonalizedLearning" android:singleLine="true" android:maxLength="1000" android:hint="@string/assessment_reason" android:saveEnabled="false" android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/assessmentConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assessment_confirm" />
    <com.google.android.material.button.MaterialButton android:id="@+id/assessmentRetry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assessment_retry" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/assessmentReload" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assessment_reload" />
</LinearLayout>
