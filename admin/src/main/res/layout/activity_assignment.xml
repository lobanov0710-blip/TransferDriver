<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/assignmentRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/assignmentToolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="@string/assignment_title" app:navigationIcon="@drawable/ic_assignment_back"
        app:navigationContentDescription="@string/assignment_back" />
    <ProgressBar android:id="@+id/assignmentProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/assignmentMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:accessibilityLiveRegion="polite" android:saveEnabled="false" />
    <Spinner android:id="@+id/assignmentFilter" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:saveEnabled="false" android:contentDescription="@string/assignment_filter" />
    <TextView android:id="@+id/assignmentHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:textAppearance="?attr/textAppearanceTitleLarge" android:saveEnabled="false" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:saveEnabled="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/assignmentRows" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:saveEnabled="false" />
            <LinearLayout android:id="@+id/assignmentForm" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/assignmentSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge" android:saveEnabled="false" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:hint="@string/assignment_reason" app:helperText="@string/assignment_reason_help">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/assignmentReason"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp"
                        android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions" android:maxLength="500"
                        android:imeOptions="flagNoPersonalizedLearning" android:saveEnabled="false" android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/assignmentPaging" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/assignmentPrevious" style="?attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assignment_previous" />
        <Button android:id="@+id/assignmentNext" style="?attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assignment_next" />
    </LinearLayout>
    <Button android:id="@+id/assignmentConfirm" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/assignment_prepare" android:visibility="gone" />
    <Button android:id="@+id/assignmentRetry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/assignment_retry" android:visibility="gone" />
    <Button android:id="@+id/assignmentReload" style="?attr/borderlessButtonStyle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/assignment_reload" />
</LinearLayout>
