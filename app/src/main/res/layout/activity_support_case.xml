<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textSupportCaseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/support_case_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSupportCaseMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textSupportCaseStatusMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/support_loading"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progressSupportCase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSupportMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/editSupportMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/support_message_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="4000"
        android:maxLines="5"
        android:minLines="2" />

    <Button
        android:id="@+id/buttonSendSupportMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/support_send" />

    <Button
        android:id="@+id/buttonSupportCaseRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/refresh" />

</LinearLayout>
